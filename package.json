{
  "name": "digit-nepal-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run start:dev --workspace @digitnepal/backend\" \"npm run dev --workspace @digitnepal/frontend\"",
    "dev:web": "npm run dev --workspace @digitnepal/frontend",
    "dev:api": "npm run start:dev --workspace @digitnepal/backend",
    "build": "npm run build --workspace @digitnepal/backend && npm run build --workspace @digitnepal/frontend",
    "clean:artifacts": "rm -rf frontend/.next backend/dist",
    "clean:deps": "rm -rf node_modules frontend/node_modules backend/node_modules",
    "clean": "npm run clean:artifacts",
    "lint": "npm run lint --workspace @digitnepal/backend && npm run lint --workspace @digitnepal/frontend",
    "prisma:generate": "npm run prisma:generate --workspace @digitnepal/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace @digitnepal/backend",
    "prisma:seed": "npm run prisma:seed --workspace @digitnepal/backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
